# Copy to .env and fill in. NEVER commit .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# For Ollama instead: LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
# Qwen3-style thinking models are faster with thinking off:
OLLAMA_THINK=false

DEFAULT_CURRENCY=ETB

# Transport: stdio (default, server runs as subprocess) or http (connect to running server)
MCP_TRANSPORT=stdio
# When MCP_TRANSPORT=http, the client connects to this URL:
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# Shared secret for bearer auth (optional, same value in server and client):
SERVER_API_KEY=
